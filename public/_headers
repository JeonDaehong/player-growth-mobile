# 정적 자산은 파일명에 해시가 붙어 있어 영구 캐시해도 안전하다.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html 은 절대 캐시하지 않는다 — 캐시되면 새 빌드를 올려도
# 테스터가 옛날 번들을 계속 받는다 (베타에서 제일 흔한 "고쳤는데 그대로예요")
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# 서비스 워커는 절대 캐시하지 않는다 — 캐시되면 새 워커가 안 걸리고,
# 그러면 워커가 들고 있는 낡은 캐시 규칙이 계속 산다 (고치기 제일 어려운 종류의 버그)
/sw.js
  Cache-Control: no-cache

# manifest 와 아이콘은 이름에 해시가 없다. 짧게 잡아 둔다
/manifest.webmanifest
  Cache-Control: public, max-age=3600
/icons/*
  Cache-Control: public, max-age=86400
